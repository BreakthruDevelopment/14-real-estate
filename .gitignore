# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# The 2048x2048 worst-allowed-input image fixtures (~14 MB). Written by `pnpm fixtures:images`, and by the
# image tests on first run; kept out of the repo and out of the Docker build context.
/test/fixtures/images/generated/

# Benchmark harness built by the image CI job (bundle + a copy of scripts/bench-images.cjs).
/bench/
