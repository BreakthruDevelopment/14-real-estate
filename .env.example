# Copy to .env.local for local development. Never commit real values.
# In the cloud, these come from each cloud's secret manager via Terraform.

APP_NAME="30 Apps Template"
APP_URL=http://localhost:3000

DATABASE_URL=postgres://app:app@localhost:5432/app

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# demo | gemini | anthropic
AI_PROVIDER=demo
AI_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_FALLBACK_TO_DEMO=true
# Embedding model for embed() (default gemini-embedding-2) and the timeout for every model call
AI_EMBED_MODEL=
AI_TIMEOUT_MS=20000

# Caps (defaults shown). Photo bytes stored app-wide, AI calls and embeddings per UTC day, and the shared
# Postgres server's provisioned storage for the /admin warning.
PHOTO_STORE_CAP_MB=600
AI_DAILY_CAP=200
EMBED_DOC_DAILY_CAP=500
EMBED_QUERY_DAILY_CAP=1000
DB_SERVER_STORAGE_GB=32

LOG_LEVEL=info

# Only for apps that store secrets (see README, "Encrypting stored secrets"). Generate with: openssl rand -base64 32
# TOKEN_ENC_KEY_PREVIOUS is set only while rotating.
TOKEN_ENC_KEY=
TOKEN_ENC_KEY_PREVIOUS=

# Apply pending migrations when the server starts (used in the cloud)
MIGRATE_ON_START=false

# Optional, used by `pnpm db:seed` against a running app
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
# Agents are granted by an admin in the app; seeding one here is for CI and the smoke test.
SEED_AGENT_EMAIL=
SEED_AGENT_PASSWORD=
SEED_AGENT2_EMAIL=
SEED_AGENT2_PASSWORD=
